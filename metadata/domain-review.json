{
  "repo": "signal-trace-slo-dock",
  "language": "Scala",
  "category": "Observability",
  "goal": "Package a Scala local lab for slo analysis with seeded input scenarios, deterministic summary checks, and documented operating limits.",
  "review_model": {
    "terms": [
      "span volume",
      "latency skew",
      "signal loss",
      "incident shape"
